@{
    Layout = null;
    ViewData["Title"] = "Panel Estudiante";
    string rol = ViewBag.Rol;
    string nombre = ViewBag.Nombre;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aula Virtual - @rol</title>

    <!-- Tus estilos -->
    <link href="~/css/menuprincipal/menuprincipal.css" rel="stylesheet" />
    <link href="~/css/m_principal/MenuPrincipal.css" rel="stylesheet" />
    <link href="~/css/menu/menu.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>

<body>
    @if (rol == "Profesor")
    {
        <!-- NAV SUPERIOR -->
        <nav class="topnav" role="navigation" aria-label="Principal">
            <ul class="nav-actions">
                <li><a class="nav-link active" href="/Login/Login"><i class="fa-solid fa-house"></i> Login</a></li>
                <li>
                    <a class="nav-link" href="/Proyectos/V_Proyectos">
                        <i class="fa-solid fa-layer-group"></i> Crear Proyectos
                    </a>
                </li>
                <li><a class="nav-link" href="/Tareas/V_Tareas"><i class="fa-solid fa-sheet-plastic"></i> Crear Tareas</a></li>
                <li><a class="nav-link" href="#config"><i class="fa-solid fa-gear"></i> Configuración</a></li>
            </ul>
            <div class="brand">
                <span>Aula Virtual</span>
            </div>
        </nav>

        <!-- Contenido principal -->
        <main class="main">
            <header class="header">
                <h1>Recursos</h1>
            </header>
            <div class="section-title">
                <i class="fa-regular fa-square-plus"></i> Profesor
            </div>
        </main>
    }
    else if (rol == "Estudiante")
    {
        <!-- NAV SUPERIOR -->
        <nav class="topnav" role="navigation" aria-label="Principal">
            <ul class="nav-actions">
                <li><a class="nav-link active" href="/Login/Login"><i class="fa-solid fa-house"></i> Login</a></li>
                <li><a class="nav-link" href="/Tareas/V_Tareas"><i class="fa-solid fa-sheet-plastic"></i> Crear Tareas</a></li>
                
            </ul>
            <div class="brand">
                <span>Aula Virtual</span>
            </div>
        </nav>

        <!-- Contenido principal -->
        <main class="main">
            <header class="header">
                <h1>Recursos</h1>
            </header>
            <div class="section-title">
                <i class="fa-regular fa-square-plus"></i> Estudiantes
            </div>

            <!-- Proyectos Asignados -->
            @if (ViewBag.ListaProyectos != null && ((List<Entities.Proyectos>)ViewBag.ListaProyectos).Count > 0)
            {
                <section class="projects-section" style="margin: 20px 0;">
                    <h2 style="margin-bottom: 15px;">
                        <i class="fa-solid fa-layer-group"></i> Proyectos Asignados
                    </h2>
                    <div class="projects-list" style="display: flex; flex-direction: column; gap: 10px;">
                        @foreach (var proyecto in (List<Entities.Proyectos>)ViewBag.ListaProyectos)
                        {
                            <div class="project-card" style="border: 1px solid #ddd; border-radius: 8px; padding: 15px; background: #fff;">
                                <div style="display: flex; justify-content: space-between; align-items: start;">
                                    <div style="flex: 1;">
                                        <h3 style="margin-top: 0; color: #297ea6;">@proyecto.nombre</h3>
                                        <p style="color: #666; font-size: 0.9em;">@proyecto.descripcion</p>
                                        <div style="margin-top: 10px; display: flex; gap: 15px; flex-wrap: wrap;">
                                            <span style="background: #297ea6; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.85em;">
                                                @(proyecto.estado ?? "pendiente")
                                            </span>
                                            <span style="font-size: 0.85em; color: #888;">
                                                <i class="fa-solid fa-calendar"></i> 
                                                Límite: @proyecto.fecha_finalizacion.ToString("dd/MM/yyyy")
                                            </span>
                                            @if (!string.IsNullOrEmpty(proyecto.curso))
                                            {
                                                <span style="font-size: 0.85em; color: #888;">
                                                    <i class="fa-solid fa-graduation-cap"></i> @proyecto.curso
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(proyecto.NombreProfesor))
                                        {
                                            <div style="margin-top: 10px; padding-top: 10px; border-top: 1px solid #eee;">
                                                <p style="font-size: 0.85em; color: #555; margin: 5px 0;">
                                                    <i class="fa-solid fa-chalkboard-teacher"></i> 
                                                    <strong>Asignado por:</strong> @proyecto.NombreProfesor
                                                </p>
                                            </div>
                                        }
                                        @if (proyecto.Integrantes != null && proyecto.Integrantes.Count > 0)
                                        {
                                            <div style="margin-top: 8px;">
                                                <p style="font-size: 0.85em; color: #555; margin: 5px 0;">
                                                    <i class="fa-solid fa-users"></i> 
                                                    <strong>Integrantes:</strong>
                                                </p>
                                                <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 5px;">
                                                    @foreach (var integrante in proyecto.Integrantes)
                                                    {
                                                        <span style="background: #e8f4f8; color: #297ea6; padding: 4px 10px; border-radius: 12px; font-size: 0.8em;">
                                                            @integrante.NombreCompleto
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
            else
            {
                <section class="projects-section" style="margin: 20px 0;">
                    <h2 style="margin-bottom: 15px;">
                        <i class="fa-solid fa-layer-group"></i> Proyectos Asignados
                    </h2>
                    <p style="color: #888; font-style: italic;">No tienes proyectos asignados.</p>
                </section>
            }

            <!-- Tareas Asignadas -->
            @if (ViewBag.ListaTareas != null && ((List<Entities.Tarea>)ViewBag.ListaTareas).Count > 0)
            {
                <section class="tasks-section" style="margin: 20px 0;">
                    <h2 style="margin-bottom: 15px;">
                        <i class="fa-solid fa-sheet-plastic"></i> Tareas Asignadas
                    </h2>
                    <div class="tasks-list" style="display: flex; flex-direction: column; gap: 10px;">
                        @foreach (var tarea in (List<Entities.Tarea>)ViewBag.ListaTareas)
                        {
                            <div class="task-card" data-tarea-id="@tarea.Id" style="border: 1px solid #ddd; border-radius: 8px; padding: 15px; background: #fff;">
                                <div style="display: flex; justify-content: space-between; align-items: start;">
                                    <div style="flex: 1;">
                                        <h3 style="margin-top: 0; color: #297ea6;">@tarea.Titulo</h3>
                                        <p style="color: #666; font-size: 0.9em;">@tarea.Descripcion</p>
                                        <div style="margin-top: 10px; display: flex; gap: 15px; flex-wrap: wrap; align-items: center;">
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <label style="font-size: 0.85em; color: #555; font-weight: bold;">Estado:</label>
                                                <select class="estado-select" data-tarea-id="@tarea.Id" data-estado-actual="@tarea.Estado" style="padding: 4px 8px; border-radius: 4px; border: 1px solid #ddd; font-size: 0.85em; background: white; cursor: pointer;">
                                                    <option value="pendiente" @(tarea.Estado?.ToLower() == "pendiente" ? "selected" : "")>Pendiente</option>
                                                    <option value="en progreso" @(tarea.Estado?.ToLower() == "en progreso" ? "selected" : "")>En Progreso</option>
                                                    <option value="completada" @(tarea.Estado?.ToLower() == "completada" ? "selected" : "")>Completada</option>
                                                </select>
                                            </div>
                                            <span style="font-size: 0.85em; color: #888;">
                                                <i class="fa-solid fa-calendar"></i> 
                                                Límite: @tarea.FechaLimite.ToString("dd/MM/yyyy")
                                            </span>
                                            @if (!string.IsNullOrEmpty(tarea.Curso))
                                            {
                                                <span style="font-size: 0.85em; color: #888;">
                                                    <i class="fa-solid fa-graduation-cap"></i> @tarea.Curso
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(tarea.NombreCreador))
                                        {
                                            <div style="margin-top: 10px; padding-top: 10px; border-top: 1px solid #eee;">
                                                <p style="font-size: 0.85em; color: #555; margin: 5px 0;">
                                                    <i class="fa-solid fa-user-plus"></i> 
                                                    <strong>Creado por:</strong> @tarea.NombreCreador
                                                </p>
                                            </div>
                                        }
                                        @if (tarea.EstudiantesAsignados != null && tarea.EstudiantesAsignados.Count > 0)
                                        {
                                            <div style="margin-top: 8px;">
                                                <p style="font-size: 0.85em; color: #555; margin: 5px 0;">
                                                    <i class="fa-solid fa-user-check"></i> 
                                                    <strong>Asignado a:</strong>
                                                </p>
                                                <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 5px;">
                                                    @foreach (var estudiante in tarea.EstudiantesAsignados)
                                                    {
                                                        <span style="background: #fff3cd; color: #856404; padding: 4px 10px; border-radius: 12px; font-size: 0.8em;">
                                                            @estudiante.NombreCompleto
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
            else
            {
                <section class="tasks-section" style="margin: 20px 0;">
                    <h2 style="margin-bottom: 15px;">
                        <i class="fa-solid fa-sheet-plastic"></i> Tareas Asignadas
                    </h2>
                    <p style="color: #888; font-style: italic;">No tienes tareas asignadas.</p>
                </section>
            }
        </main>
    }
    else if (rol == "Administrador")
    {
        <div class="alert alert-info">
            <h5>Opciones del Administrador</h5>
            <ul>
                <li><a href="/Home/Index">Ir al panel principal</a></li>
                <li><a href="/Database/Test">Probar conexión a base de datos</a></li>
            </ul>
        </div>
    }
    else
    {
        <div class="alert alert-warning">Rol no reconocido.</div>
    }

    @if (rol == "Estudiante")
    {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                // Manejar cambio de estado de tareas
                const estadoSelects = document.querySelectorAll('.estado-select');
                
                estadoSelects.forEach(select => {
                    select.addEventListener('change', function() {
                        const tareaId = this.dataset.tareaId;
                        const nuevoEstado = this.value;
                        const estadoAnterior = this.dataset.estadoAnterior || this.options[this.selectedIndex - 1]?.value;
                        
                        // Confirmar cambio
                        Swal.fire({
                            title: '¿Actualizar estado?',
                            text: `¿Cambiar el estado a "${nuevoEstado}"?`,
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonColor: '#297ea6',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'Sí, actualizar',
                            cancelButtonText: 'Cancelar'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // Deshabilitar el select mientras se procesa
                                this.disabled = true;
                                
                                // Enviar petición al servidor
                                fetch('/Tareas/ActualizarEstadoTarea', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify({
                                        tareaId: parseInt(tareaId),
                                        estado: nuevoEstado
                                    })
                                })
                                .then(response => response.json())
                                .then(resultado => {
                                    if (resultado.ok) {
                                        // Actualizar el badge de estado si existe
                                        const taskCard = this.closest('.task-card');
                                        const estadoBadge = taskCard.querySelector('.estado-badge');
                                        if (estadoBadge) {
                                            estadoBadge.textContent = nuevoEstado;
                                        }
                                        
                                        // Actualizar colores según el estado
                                        const colores = {
                                            'pendiente': '#297ea6',
                                            'en progreso': '#ff9800',
                                            'completada': '#4caf50'
                                        };
                                        
                                        this.style.background = colores[nuevoEstado.toLowerCase()] || '#297ea6';
                                        this.style.color = 'white';
                                        
                                        Swal.fire({
                                            title: '¡Actualizado!',
                                            text: resultado.mensaje || 'Estado actualizado exitosamente',
                                            icon: 'success',
                                            timer: 2000,
                                            showConfirmButton: false
                                        });
                                        
                                        // Guardar el estado actual
                                        this.dataset.estadoAnterior = nuevoEstado;
                                    } else {
                                        // Revertir el cambio
                                        const estadoAnterior = this.dataset.estadoAnterior || 'pendiente';
                                        this.value = estadoAnterior;
                                        
                                        Swal.fire({
                                            title: 'Error',
                                            text: resultado.mensaje || 'No se pudo actualizar el estado',
                                            icon: 'error'
                                        });
                                    }
                                })
                                .catch(error => {
                                    console.error('Error:', error);
                                    // Revertir el cambio
                                    const estadoAnterior = this.dataset.estadoAnterior || 'pendiente';
                                    this.value = estadoAnterior;
                                    
                                    Swal.fire({
                                        title: 'Error',
                                        text: 'Ocurrió un error al actualizar el estado',
                                        icon: 'error'
                                    });
                                })
                                .finally(() => {
                                    // Rehabilitar el select
                                    this.disabled = false;
                                });
                            } else {
                                // Revertir el cambio si el usuario cancela
                                const estadoAnterior = this.dataset.estadoAnterior || 'pendiente';
                                this.value = estadoAnterior;
                            }
                        });
                    });
                    
                    // Guardar el estado inicial
                    select.dataset.estadoAnterior = select.value;
                    
                    // Aplicar colores según el estado inicial
                    const estadoActual = select.value.toLowerCase();
                    const colores = {
                        'pendiente': '#297ea6',
                        'en progreso': '#ff9800',
                        'completada': '#4caf50'
                    };
                    select.style.background = colores[estadoActual] || '#297ea6';
                    select.style.color = 'white';
                });
            });
        </script>
    }
</body>
</html>
