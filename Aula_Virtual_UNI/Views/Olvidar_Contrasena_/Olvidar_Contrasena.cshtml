@{
    Layout = null;
}


<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Recuperar Contraseña</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <link href="~/css/olvidar_contrasena/olvidar_contrasena.css" rel="stylesheet" />
    <script src="~/js/contrasena/contrasena.js"></script>
</head>

<body>
    <div class="container-fluid d-flex align-items-center justify-content-center" style="min-height: 100vh;">
        <div class="main-container row">
            <div class="col-md-6 left-col">
                <img src="~/recursos/estudiantes.svg" />
                <div class="welcome-text">
                    Bienvenido(a) al Aula Virtual de la UNI
                </div>
            </div>
            <div class="col-md-6 right-col">
                @* <img src="https://aulavirtual.uisil.ac.cr/pluginfile.php/1/theme_uisil/logo/1683222222/UISIL.png" alt="UISIL Logo" class="logo-img" />*@
                <div class="d-flex mb-4">
                   
                    <button class="btn btn-yellow" onclick="window.location.href='/Login/Login'">Iniciar sesión</button>
                    <button class="btn btn-yellow" onclick="window.location.href='/CrearCuenta/CrearCuenta'">Crear cuenta</button>
                </div>
                <div class="divider"></div>
                <div class="instructions">
                    Por favor, digita tu Usuario o Correo y <br /> te mostraremos tu contraseña.
                </div>
                <form id="formRecuperarContrasena">
                    <div class="input-group mb-4">
                        <span class="input-group-text bg-light"><i class="fa fa-user" aria-hidden="true"></i></span>
                        <input type="text" id="inputUsuario" class="form-control" placeholder="Usuario o Correo electrónico" required />
                    </div>
                    
                    <button type="submit" id="btnMostrarContrasena" class="btn btn-green mb-2">Mostrar Contraseña</button>
                    <div class="input-group mb-3 mt-3" id="contenedorContrasena">
                        <span class="input-group-text bg-light"><i class="fa fa-key" aria-hidden="true"></i></span>
                        <input type="text" id="inputContrasena" class="form-control" placeholder="Contraseña" readonly />
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>

</html>

