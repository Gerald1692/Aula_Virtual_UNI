@{
    Layout = null;

    var ListaTareas = ViewBag.ListaTareas;

}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aula Virtual - Tareas</title>
    <!-- Tus estilos -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">  
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <link href="~/css/Tarea/Tarea.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <script src="~/js/Tarea.js"></script>



    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>


</head>

<body>
    <!-- NAV SUPERIOR -->
    <nav class="topnav" role="navigation" aria-label="Principal">
        <ul class="nav-actions">

            <li>
                <a class="nav-link" href="/Menu/V_Menu">
                    <i class="fa-solid fa-bars"></i> Menu Principal
                </a>
            </li>
            </a>
            </li>
            <!-- <li><a class="nav-link" href="#Tareas"><i class="fa-solid fa-layer-group"></i> Crear Tareas</a></li>-->

        </ul>
        <div class="brand">
            <span>Aula Virtual</span>
        </div>
    </nav>

    <!-- Contenido principal -->
    <main class="main">
        <header class="header">
            <h1>Crear Tareas</h1>
            <form class="task-form" action="#" method="post">
                <label class="form-field">
                    <span>Nombre de la tarea</span>
                    <input type="text" name="nombre" required />
                </label>
                <label class="form-field">
                    <span>Curso</span>
                    <input type="text" name="curso" required />
                </label>
                <label class="form-field">
                    <span>Fecha de entrega</span>
                    <input type="date" name="fecha" required />
                </label>
                <label class="form-field">
                    <span>Descripción de la tarea</span>
                    <textarea name="descripcion" rows="3" required></textarea>
                </label>
                <div class="form-field form-action">
                    <span>&nbsp;</span>
                    <button type="submit" class="btn-create">
                        <i class="fa-solid fa-plus"></i> <span class="label-text">Crear</span>
                    </button>
                </div>
            </form>
        </header>
        <div class="section-title">
            <i class="fa-regular fa-square-plus"></i> Profesor
        </div>

        <section class="tasks" aria-live="polite">
            <h2 class="task-list-title">
                <i class="fa-solid fa-list-check"></i> Tareas creadas
            </h2>
            <div class="task-list" id="taskList">
         

                @if (ListaTareas != null)
                {
                    @foreach (var Tarea in ListaTareas)
                    {

                        <article class="task-card"
                                 data-nombre="@Tarea.Nombre"
                                 data-curso="@Tarea.Curso"
                                 data-descripcion="@Tarea.Descripcion"
                                 data-fecha="@Tarea.FechaEntrega.ToString("yyyy-MM-dd")"
                                 data-estado="@Tarea.Estado">
                            <div class="task-card-header">
                                <h3 class="task-title">@Tarea.Nombre</h3>
                                <div class="task-meta">
                                    <span class="task-status is-pending">@Tarea.Estado</span>
                                    <span class="task-date">@Tarea.FechaEntrega.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>

                            <p class="task-course">
                                <i class="fa-solid fa-graduation-cap"></i>
                                <span class="course-text">@Tarea.Curso</span>
                            </p>

                            <p class="task-description">@Tarea.Descripcion</p>

                            <div class="task-card-actions">

                                <!--Este es el dropdown-->
                                <div class="container">
                                    <div class="dropdown">
                                        <button class="btn btn-primary dropdown-toggle" type="button" id="dropdown1" data-toggle="dropdown">
                                            Asignar Alumnos
                                        </button>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" href="http://www.google.com">Google</a>
                                            <a class="dropdown-item" href="http://www.bing.com">Bing</a>
                                            <a class="dropdown-item" href="http://www.yahoo.com">Yahoo</a>
                                        </div>
                                    </div>
                                </div>



                                <button type="button" class="btn-action btn-edit">
                                    <i class="fa-solid fa-pen-to-square"></i> Editar
                                </button>

                                <button type="button" class="btn-action btn-status">
                                    <i class="fa-solid fa-flag"></i> Estado: Pendiente
                                </button>

                                <button type="button" class="btn-action btn-delete">
                                    <i class="fa-solid fa-trash"></i> Eliminar
                                </button>
                            </div>
                        </article>

                    
                    }
                }



                <p class="empty-state" id="emptyState">Aún no hay tareas creadas.</p>
            </div>
        </section>
    </main>


</body>
</html>




