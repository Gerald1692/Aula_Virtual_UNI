@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Registro de Usuario</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="~/css/crearcuenta/crearcuenta.css" rel="stylesheet" />
</head>
<body>
    <main class="container">
        <h1 class="mt-5 text-center" style="text-align: right;">Registro de Usuario</h1>

        <!-- Contenedor blanco para el formulario -->
        <div class="registro-card mx-auto mt-4">
            <form id="formRegistro" method="post" class="">

                <button type="button" class="btn btn-primary mb-5" onclick="window.location.href='/Login/Login'">Volver</button>

                <!-- Mensaje de alerta -->
                <div id="alertMessage" class="alert d-none" role="alert"></div>

                <div class="mb-3">
                    <label for="nombre" class="form-label">Nombre <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="nombre" name="nombre" required 
                           pattern="[A-Za-zÁÉÍÓÚáéíóúÑñ\s]+" 
                           title="Solo se permiten letras y espacios" />
                    <div class="invalid-feedback">Por favor ingrese un nombre válido.</div>
                </div>

                <div class="mb-3">
                    <label for="apellido1" class="form-label">Primer Apellido <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="apellido1" name="apellido1" required 
                           pattern="[A-Za-zÁÉÍÓÚáéíóúÑñ\s]+" 
                           title="Solo se permiten letras y espacios" />
                    <div class="invalid-feedback">Por favor ingrese el primer apellido.</div>
                </div>

                <div class="mb-3">
                    <label for="apellido2" class="form-label">Segundo Apellido <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="apellido2" name="apellido2" required 
                           pattern="[A-Za-zÁÉÍÓÚáéíóúÑñ\s]+" 
                           title="Solo se permiten letras y espacios" />
                    <div class="invalid-feedback">Por favor ingrese el segundo apellido.</div>
                </div>

                <div class="mb-3">
                    <label for="cedula" class="form-label">Cédula <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="cedula" name="cedula" required 
                           maxlength="20" pattern="[0-9]+" title="Solo se permiten números" />
                    <div class="invalid-feedback">Por favor ingrese una cédula válida.</div>
                    <div id="cedulaFeedback" class="form-text"></div>
                </div>

                <div class="mb-3">
                    <label for="telefono" class="form-label">Teléfono <span class="text-danger">*</span></label>
                    <input type="tel" class="form-control" id="telefono" name="telefono" required 
                           maxlength="20" pattern="[0-9+\-\s()]+" title="Ingrese un número de teléfono válido" />
                    <div class="invalid-feedback">Por favor ingrese un teléfono válido.</div>
                </div>

                <div class="mb-3">
                    <label for="correo" class="form-label">Correo electrónico <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" id="correo" name="correo" required 
                           title="Ingrese un correo electrónico válido" />
                    <div class="invalid-feedback">Por favor ingrese un correo electrónico válido.</div>
                </div>

                <div class="mb-3">
                    <label for="sede" class="form-label">Sede <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="sede" name="sede" required 
                           maxlength="150" />
                    <div class="invalid-feedback">Por favor ingrese una sede.</div>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Contraseña <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="password" name="password" required />
                        <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="invalid-feedback">Por favor ingrese una contraseña.</div>
                </div>

                <div class="mb-3">
                    <label for="confirmPassword" class="form-label">Confirmar contraseña <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required />
                        <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="invalid-feedback">Las contraseñas no coinciden.</div>
                </div>

                <button type="submit" class="btn btn-primary w-100" id="btnRegistrar">
                    <span id="btnText">Registrarse</span>
                    <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                </button>

            </form>
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/crearcuenta/crearcuenta.js"></script>
</body>
</html>